# Copy to `.env` and fill in only what you actually need.
#
# NOTHING in this file is required to clone, build, run or verify this product. The measurement is
# committed; the site replays it; the gate drives the built site. A key is needed only to take a
# NEW measurement, which is a deliberate, budgeted, offline act.
#
# `.env` is gitignored. Secrets in this line of work live in the private management repo, never
# here.

# ---------------------------------------------------------------------------- the hosted lane
# Needed only by `data-pipeline/sweep_run.py --provider anthropic`.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------- the local lane
# Needed only by `--provider ollama`. Defaults to a local Ollama daemon, so usually leave it unset.
# OLLAMA_HOST=http://127.0.0.1:11434

# ---------------------------------------------------------------------------- the build
# The Vite base path. Leave UNSET for a domain root, which is what this product deploys to.
#
# Do not set it to an empty string: an empty string is not "unset", and the build treats it as a
# RELATIVE base. Every deployed document then references ./assets/..., which resolves one directory
# too deep behind a trailing-slash redirect and 404s, and every page answers 200 while rendering
# nothing. That shipped once.
# VITE_BASE=/CAOS_Enunciado/

# ---------------------------------------------------------------------------- the gate
# Point the UI gate at a deployed origin instead of the local build:
#   VERIFY_BASE=https://enunciado.fasl-work.com node tools/visual-verify/verify.mjs
# VERIFY_BASE=

# Keep Playwright's browsers off the system drive.
# PLAYWRIGHT_BROWSERS_PATH=E:/_Temp/ms-playwright
